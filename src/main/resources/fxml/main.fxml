<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="500.0"
        prefWidth="800.0"
        stylesheets="@../css/main.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="agenda.app.view.controller.MainController">

    <!-- ========================================================= -->
    <!-- MENU LATERAL -->
    <!-- ========================================================= -->

    <left>

        <VBox fx:id="sidebar"
              alignment="TOP_CENTER"
              spacing="12">

            <padding>
                <Insets top="20"
                        right="12"
                        bottom="20"
                        left="12"/>
            </padding>

            <!-- Novo contato -->
            <Button fx:id="btnNovoContato"
                    text="+"
                    prefWidth="42"
                    prefHeight="42"
                    onAction="#openRegisterWindow"/>

            <!-- Contatos -->
            <Button fx:id="btnContatos"
                    text="👤"
                    prefWidth="42"
                    prefHeight="42"/>

            <!-- Favoritos -->
            <Button fx:id="btnFavoritos"
                    text="♡"
                    prefWidth="42"
                    prefHeight="42"/>

        </VBox>

    </left>


    <!-- ========================================================= -->
    <!-- ÁREA PRINCIPAL -->
    <!-- ========================================================= -->

    <center>

        <BorderPane fx:id="contentArea">

            <!-- ================================================= -->
            <!-- LISTA DE CONTATOS -->
            <!-- ================================================= -->

            <left>

                <VBox fx:id="contactListContainer"
                      prefWidth="250"
                      spacing="10">

                    <padding>
                        <Insets top="20"
                                right="15"
                                bottom="20"
                                left="15"/>
                    </padding>

                    <!-- Cabeçalho -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="8">

                        <Label text="Contatos"
                               styleClass="section-title"/>

                        <Label fx:id="quantidadeDeContatos"
                               styleClass="counter"/>

                    </HBox>


                    <!-- Pesquisa -->

                    <Label text="Pesquisar contato"
                           styleClass="search-label"/>


                    <!-- Lista -->

                    <ListView fx:id="listaContatos"
                              VBox.vgrow="ALWAYS"/>

                </VBox>

            </left>


            <!-- ================================================= -->
            <!-- PERFIL -->
            <!-- ================================================= -->

            <center>

                <VBox fx:id="profileContainer"
                      alignment="TOP_CENTER"
                      spacing="18">

                    <padding>
                        <Insets top="30"
                                right="30"
                                bottom="30"
                                left="30"/>
                    </padding>


                    <!-- Foto -->

                    <VBox alignment="CENTER"
                          spacing="10">

                        <ImageView fx:id="fotoContato"
                                   fitWidth="140"
                                   fitHeight="140"
                                   preserveRatio="false"/>

                        <Label text="Foto do contato"
                               styleClass="photo-label"/>

                    </VBox>


                    <!-- Nome -->

                    <Label fx:id="lblNome"
                           text="Nome do contato"
                           styleClass="profile-name"/>


                    <!-- Informações -->

                    <VBox fx:id="contactInfo"
                          spacing="14"
                          prefWidth="250">

                        <HBox spacing="10">

                            <Label text="✉"
                                   styleClass="info-icon"/>

                            <VBox>

                                <Label text="E-mail"
                                       styleClass="info-title"/>

                                <Label fx:id="lblEmail"
                                       text="email@exemplo.com"
                                       styleClass="info-value"/>

                            </VBox>

                        </HBox>


                        <HBox spacing="10">

                            <Label text="☎"
                                   styleClass="info-icon"/>

                            <VBox>

                                <Label text="Telefone"
                                       styleClass="info-title"/>

                                <Label fx:id="lblTelefone"
                                       text="(00) 00000-0000"
                                       styleClass="info-value"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- Ações -->

                    <HBox spacing="10">

                        <Button fx:id="btnEditar"
                                text="Editar"
                                prefWidth="90"
                                prefHeight="34"/>

                        <Button fx:id="btnExcluir"
                                text="Excluir"
                                prefWidth="90"
                                prefHeight="34"/>

                    </HBox>

                </VBox>

            </center>

        </BorderPane>

    </center>

</BorderPane>