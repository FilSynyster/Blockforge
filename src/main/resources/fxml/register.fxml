<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="230"
            prefHeight="340"
            stylesheets="@../css/register.css"
            fx:controller="agenda.app.view.controller.RegisterController">

    <center>

        <VBox spacing="8"
              alignment="TOP_CENTER"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="10"
                        right="10"
                        bottom="10"
                        left="10"/>
            </padding>

            <!-- Título -->
            <Label text="Novo Contato"/>

            <!-- Foto do contato -->
            <ImageView fx:id="fotoContato"
                       fitWidth="120"
                       fitHeight="100"
                       preserveRatio="false"/>

            <!-- Botões da foto -->
            <HBox spacing="5"
                  alignment="CENTER">

                <Button fx:id="btnAdicionarFoto"
                        prefHeight="27"
                        text="Add foto"/>

                <Button fx:id="btnRemoverFoto"
                        prefHeight="27"
                        text="Remover foto"/>

            </HBox>

            <!-- Nome -->
            <TextField fx:id="txtNome"
                       promptText="Nome do contato"
                       prefWidth="166"
                       prefHeight="27"/>

            <!-- E-mail -->
            <TextField fx:id="txtEmail"
                       promptText="E-mail"
                       prefWidth="166"
                       prefHeight="27"/>

            <!-- Telefone -->
            <TextField fx:id="txtTelefone"
                       promptText="Telefone"
                       prefWidth="166"
                       prefHeight="27"/>

            <!-- Botões -->
            <HBox spacing="32"
                  alignment="CENTER">

                <Button fx:id="btnSalvar"
                        text="Salvar"
                        prefWidth="84"
                        prefHeight="27"
                        onAction="#saveContact"/>

                <Button fx:id="btnCancelar"
                        text="Cancelar"
                        prefWidth="84"
                        prefHeight="27"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>