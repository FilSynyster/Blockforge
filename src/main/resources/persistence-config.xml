<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <context name="agenda-persistence">

        <url value="jdbc:sqlite:database/data.db"/>
        <driver value="org.sqlite.JDBC"/>

        <!--Define o pacote raiz da aplicação para o escaneamento dos repositórios -->
        <root-package value="agenda" />

        <!--Define em qual pacote as entidades que pertencem
        a esse contexto de persistência estão.
        Uma aplicação pode ter mais de um contexto de persistência.-->
        <entity-package value="agenda.app.models" />

        <ddl-auto value="create"/>

        <pool-size value="5"/>
        <connection-timeout value="30000"/>

    </context>


    <!--<context name="cache-persistence">

        <url value="jdbc:sqlite:database/cache.db?journal_mode=WAL&amp;synchronous=NORMAL"/>
        <driver value="org.sqlite.JDBC"/>

        <ddl-auto value="update"/>

        <pool-size value="2"/>
        <connection-timeout value="10000"/>

    </context>-->

</configuration>