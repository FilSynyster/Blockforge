<?xml version="1.0" encoding="UTF-8"?>
<persistence>

    <context name="agenda-persistence">

        <context-config>

            <url value="jdbc:sqlite:database/data.db"/>
            <database-provider value="sqlite" /> <!--Para banco de dados SQLite simples-->
            <ddl-auto value="ensure"/>
            <package value="agenda" />
            <pool-size value="5"/>
            <connection-timeout value="30000"/>

        </context-config>

        <entity-config>

            <package value="agenda.app.models" />

        </entity-config>

    </context>

</persistence>